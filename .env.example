# Copy to .env.local and fill in. Never commit real values.

# Google sign-in (Auth.js)
AUTH_SECRET=
AUTH_URL=http://localhost:3002
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Shared database (Neon Postgres via Vercel Marketplace)
DATABASE_URL=

# AI extraction (Phase 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email intake (Phase 3): n8n sends this in the X-Intake-Secret header
INTAKE_SECRET=

# Step 4: company details printed on proforma invoices (all optional)
COMPANY_NAME="Afro Asiatic Exporters"
COMPANY_ADDRESS="Street, City, PIN"
COMPANY_PHONE=
COMPANY_FAX=
COMPANY_EMAIL=
COMPANY_IEC=
COMPANY_GSTIN=
COMPANY_SIGNATORY=
COMPANY_PROFORMA_PREFIX="PI"
COMPANY_BANK="Bank name, branch\nA/C no., SWIFT/IFSC"

# Voice-call trial (LOCAL ONLY: switched off in production unless ALLOW_VOICE_CALLS=1)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
# Running on your own computer without Google sign-in keys (only works in `npm run dev`):
LOCAL_DEV_AUTH=
LOCAL_DEV_EMAIL=
